# Asimi's command wrapper
__asimi_run() {
  local id="$1"
  local cmd="$2"
  # Output start markers directly before any redirects can affect them
  printf "__ASIMI_STDOUT_START:%s\n" "$id"
  # Execute the command in a subshell to isolate its redirects and state
  # This ensures each command starts fresh and doesn't pollute the parent shell
  (eval "$cmd")
  local exit_code=$?
  # Output end markers after command completes, directly to original streams
  printf "__ASIMI_STDOUT_END:%s:%s\n" "$id" "$exit_code"
  return $exit_code
}
# Git shim: enforce precise staging (Li 礼)
git() {
  if [[ "$1" == "add" ]]; then
    shift
    for arg in "$@"; do
      if [[ "$arg" == "-A" || "$arg" == "." ]]; then
        echo "⚠️  Li violation: 'git add $arg' is forbidden. Stage files explicitly by path."
        echo "   Example: git add file1.go file2.go"
        return 1
      fi
    done
  fi
  for arg in "$@"; do
    if [[ "$arg" == "--hard" || "$arg" == "-f" || "$arg" == "--force" || "$arg" == "-D" || "$arg" == "--no-verify" || "$arg" == "--overwrite-ignore" ]]; then
      echo "⚠️  Li violation: 'git $*' is forbidden. Destructive/bypass flags (--hard, -f, --force, -D, --no-verify, --overwrite-ignore) are not allowed. Ask the ruler to run them for you"
      return 1
    fi
  done
  command git "$@"
}
